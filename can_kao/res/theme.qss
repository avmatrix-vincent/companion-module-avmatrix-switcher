/* ------------------------------------------------- SCSetting QSS -------------------------------------------------------------- */
SC2030Setting QLabel, 
SC7030Setting QLabel, 
SC7018Setting QLabel, 
SC1112_12G_Setting QLabel, 
SC1221_12G_Setting QLabel,
AudioWidget, QLabel,
SourceWidget QLabel,
UserSettingWidget QLabel
{
    font-size: 14px;
    color: #8b8b8b;
    /* font-family: Arial; */
}
SC2030Setting QPushButton{
    width: 50px;
    height: 16px;
    font-size: 16px;
    padding: 1px;
    border-radius: 1px;
    border-width: 1px;
    /* font-family: Arial; */
}

UserSettingWidget QLineEdit{
    font-weight: bold;
}

UC1218_4K_DeviceInfor QPushButton,
SD1242_4K_Setting QPushButton{
    border: 3px solid #111111;
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #3c3c3c, stop:0.55 #303030, stop:1 #242424);
    font-size: 12px;
    font-weight: bold;
    color: #9a9a9a;
    padding: 2px;
    border-radius: 10px;
}

UC1218_4K_DeviceInfor QPushButton:hover,
SD1242_4K_Setting QPushButton:hover{
    background-color: #5a5959;
}

UC1218_4K_DeviceInfor QPushButton:pressed,
SD1242_4K_Setting QPushButton:pressed{
    background-color: #1b1b1b;
}

UC1218_4K_DeviceInfor QPushButton:disabled,
SD1242_4K_Setting QPushButton:disabled{
    background-color: #2b2b2b;
}

SD1242_4K_Setting QPlainTextEdit{
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #242424, stop:0.55 #242424, stop:1 #242424);
    font-size: 8px;
    font-weight: bold;
    color: #9a9a9a;
    padding-top: 8px;
    padding-left: 8px; 
    border-radius: 10px;
    width: 220;
    height: 190;
}

SD1242_4K_Setting QListWidget{
    background-color: #242424;
    font-size: 14px;
    font-weight: bold;
    color: #9a9a9a;
    border-radius: 10px;
}

SD1242_4K_Setting QListWidget::item {
    border-bottom: 1px solid gray;
    height: 27px;
}
SD1242_4K_Setting QListWidget::item:hover {
    background-color: lightgray;
}
SD1242_4K_Setting QListWidget::item:selected {
    background-color: gray;
    color: white;
}

UC1218_4K_EDID QPushButton,
UC1218_4K_Audio QPushButton{
    border: 3px solid #111111;
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #3c3c3c, stop:0.55 #303030, stop:1 #242424);
    font-size: 12px;
    font-weight: bold;
    color: #9a9a9a;
    padding: 2px;
    border-radius: 10px;
}

UC1218_4K_EDID QPushButton:hover,
UC1218_4K_Audio QPushButton:hover{
    background-color: #5a5959;
}

UC1218_4K_EDID QPushButton:pressed,
UC1218_4K_Audio QPushButton:pressed{
    background-color: #1b1b1b;
}

UC1218_4K_EDID QPushButton:disabled,
UC1218_4K_Audio QPushButton:disabled{
    background-color: #2b2b2b;
}

UC1218_4K_Audio QCheckBox {
    spacing:4px;
    color: #9c9c9c;
    font-size: 12px;
}

UC1218_4K_Audio QCheckBox::indicator {
    background-color: #2d2427;
    border-radius: 2px;
    height: 20px;
    width: 20px;
}

UC1218_4K_Audio QCheckBox::indicator:checked {
    /* image: url(:/icons/images/checked.png); */
    border-image: url(:/icons/images/checked.png);
    border-radius: 2px;
}

UC1218_4K_Audio QCheckBox::indicator:disabled {
    background-color: #6b6969;
    border-radius: 2px;
    height: 20px;
    width: 20px;
}

UC1218_4K_Audio QLineEdit {
    font-size: 10px;
    background-color: #252525;
    color: #9a9a9a;
    border: none;
    border-radius: 3px;
    /* font-family: Arial; */
}

UC1218_4K_EDID QPlainTextEdit{
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #242424, stop:0.55 #242424, stop:1 #242424);
    font-size: 10px;
    color: #9a9a9a;
    padding-top: 8px;
    padding-left: 8px; 
    border-radius: 10px;
}

/* 图片RGB值：0x1A1A1A */
QPushButton[type="edid_delete"]{
    background: url(:/icons/images/delete_normal_24x24.png);
    border: 1px solid #111111;
    /* background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #d4d3d0, stop:0.55 #c7b796, stop:1 #d4af6a); */
    background-color: #d4d3d0;
    color: #9a9a9a;
    padding: 1px;
    border-radius: 4px;
}

/* 图片RGB值：0xF29900 */
QPushButton[type="edid_delete"]:hover{
    background: url(:/icons/images/delete_hover_24x24.png);
}

/* 图片RGB值：0xA36C0C */
QPushButton[type="edid_delete"]:pressed{
    background: url(:/icons/images/delete_pressed_24x24.png);
}

/* 图片RGB值：0x595959 */
QPushButton[type="edid_delete"]:disabled{
    background: url(:/icons/images/delete_disabled_24x24.png);
}

/* 图片RGB值：0x1A1A1A */
QPushButton[type="edid_save"]{
    background: url(:/icons/images/save_normal_24x24.png);
    border: 1px solid #111111;
    /* background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #d4d3d0, stop:0.55 #c7b796, stop:1 #d4af6a); */
    background-color: #d4d3d0;
    color: #9a9a9a;
    padding: 1px;
    border-radius: 4px;
}

/* 图片RGB值：0xF29900 */
QPushButton[type="edid_save"]:hover{
    background: url(:/icons/images/save_hover_24x24.png);
}

/* 图片RGB值：0xA36C0C */
QPushButton[type="edid_save"]:pressed{
    background: url(:/icons/images/save_pressed_24x24.png);
}

/* 图片RGB值：0x595959 */
QPushButton[type="edid_save"]:disabled{
    background: url(:/icons/images/save_disabled_24x24.png);
}

QPushButton[type="pvw_button"],
QPushButton[type="pgm_button"],
QPushButton[type="cut_button"]{
    border: 3px solid #111111;
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #3c3c3c, stop:0.55 #303030, stop:1 #242424);
    font-size: 12px;
    font-weight: bold;
    color: #9a9a9a;
    padding: 2px;
    border-radius: 10px;
}

QPushButton[type="pvw_button"]:hover,
QPushButton[type="pgm_button"]:hover,
QPushButton[type="cut_button"]:hover{
    background-color: #5a5959;
}

QPushButton[type="pvw_button"]:pressed,
QPushButton[type="pgm_button"]:pressed,
QPushButton[type="cut_button"]:pressed{
    background-color: #1b1b1b;
}

QPushButton[type="pvw_button"]:disabled{
    background-color: green;
}

QPushButton[type="pgm_button"]:disabled{
    background-color: red;
}

QPushButton[type="cut_button"]:disabled{
    background-color: #2b2b2b;
}