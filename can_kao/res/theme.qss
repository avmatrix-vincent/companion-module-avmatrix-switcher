    color: #8b8b8b;
    /* font-family: Arial; */
}
InputStatusWidget QLabel[type="title"]{
    font-size: 18px;
    color: #8b8b8b;
    /* font-family: Arial; */
} 

QToolButton[type='clearButton'] {
    background-color: #252525;  
    border: none;   
    padding: 0;
    margin: 2px 6px 2px 1px; 
}  
QToolButton[type='clearButton']:pressed {  
    padding-left: 1px;
    padding-bottom: 1px;
}

